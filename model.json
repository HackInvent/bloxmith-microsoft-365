{
  "kind": "microsoft_365",
  "version": "0.1.0",
  "title": "Microsoft 365",
  "description": "Work with Outlook mail and calendar, OneDrive files and Teams messages.",
  "repository_url": "https://github.com/HackInvent/bloxmith-microsoft-365",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX with Python 3.10+ and TLS support, a Microsoft Entra app registration with delegated Microsoft Graph permissions and a refresh-token grant stored in the BloxSmith wallet, and outbound HTTPS access to graph.microsoft.com, login.microsoftonline.com and the OneDrive/SharePoint download and upload hosts."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "request",
        "title": "request",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "file",
        "title": "file",
        "accepts": [
          "file/path",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "items",
        "title": "items",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "result",
        "title": "result",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "file",
        "title": "file",
        "emits": [
          "file/path",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 4,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "secret_ref": "",
    "tenant_id": "common",
    "operation": "mail_list",
    "allowed_operations": [
      "mail_list",
      "mail_get",
      "events_list",
      "files_list",
      "file_download"
    ],
    "mail_folder": "inbox",
    "drive_folder": "",
    "calendar_id": "",
    "allow_writes": false,
    "allow_send": false,
    "allowed_recipients": [],
    "allowed_channels": [],
    "attachment_root": "",
    "upload_root": "",
    "allow_delete": false,
    "watch_mail": false,
    "watch_interval_sec": 300,
    "emit_existing": false,
    "existing_since_hours": 24,
    "watch_max_items": 50,
    "body_format": "text",
    "max_body_chars": 65536,
    "list_limit": 100,
    "page_size": 50,
    "max_pages": 10,
    "window_days": 7,
    "time_zone": "UTC",
    "conflict_behavior": "fail",
    "folder_exists": "reuse",
    "max_attachment_bytes": 3145728,
    "max_upload_bytes": 52428800,
    "upload_chunk_bytes": 3276800,
    "max_download_bytes": 52428800,
    "max_kept_downloads": 20,
    "timeout_sec": 120,
    "max_request_bytes": 65536,
    "max_response_bytes": 4194304,
    "max_retries": 2,
    "max_retry_wait_sec": 30,
    "oauth_scope": "https://graph.microsoft.com/.default offline_access",
    "api_base_url": "https://graph.microsoft.com",
    "login_base_url": "https://login.microsoftonline.com",
    "ca_file": ""
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event",
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
